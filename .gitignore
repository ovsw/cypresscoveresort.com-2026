# Source photos and logos (about 1.5 GB): old-site crawl and Holly's Basecamp uploads.
# Kept locally only. Images the design round uses are copied into pre-bootstrap/design/img/.
/assets/*
!/assets/recent/
/assets/recent/*
!/assets/recent/logos/
/assets/recent/logos/*
!/assets/recent/logos/cypress-cove-logo.svg
!/assets/recent/logos/cypress-cove-logo.png

# Photo bundle sent to Claude Design (a copy of photos already in assets/)
/pre-bootstrap/docs/claude-design/cpc-photos.zip

# Local copies of the Basecamp design brief (staff names, review process). Basecamp is the source of truth.
/pre-bootstrap/docs/design-brief.md
/pre-bootstrap/docs/claude-design/cpc-design-brief-for-claude-design.md
